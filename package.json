{
  "name": "monorepo-utils",
  "version": "0.0.0",
  "description": "Utilities to keep large monorepos healthy",
  "repository": {
    "type": "git",
    "url": "https://github.com/codibre/monorepo-utils"
  },
  "private": true,
  "scripts": {
    "build": "turbo build",
    "build:force": "turbo build --force",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix --concurrency=1",
    "lint:staged": "turbo lint:staged --concurrency=1",
    "prettier": "turbo prettier --concurrency=1",
    "prettier:fix": "turbo prettier:fix --concurrency=1",
    "test": "turbo test",
    "pretest:cov": "pnpm run build && rm -f lcov.info",
    "test:cov": "turbo test:cov --concurrency=1",
    "posttest:cov": "rm -rf coverage && mkdir -p coverage && npx lcov-result-merger '**/lcov.info' coverage/lcov.info --prepend-path-fix . --prepend-source-files",
    "commit:validate": "pnpm exec commitlint --from HEAD~1 --to HEAD --verbose",
    "prepare": "husky"
  },
  "keywords": [
    "monorepo",
    "turborepo",
    "pnpm",
    "config",
    "generator",
    "drift"
  ],
  "engines": {
    "node": ">=22"
  },
  "author": "Codibre",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@stylistic/eslint-plugin": "^5.3.1",
    "@types/node": "^22.17.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.35.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lcov-result-merger": "^5.0.1",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@12.21.0"
}
