{
  "name": "config-loom",
  "version": "0.1.2",
  "description": "Eliminate config drift in pnpm + Turborepo monorepos: generate tsconfig/eslint/vitest/jest files from one regex-rules template, kept out of git",
  "keywords": [
    "turborepo",
    "turbo",
    "monorepo",
    "pnpm",
    "config",
    "config-drift",
    "generator",
    "tsconfig",
    "eslint",
    "vitest",
    "jest",
    "codegen",
    "loom"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "config-loom": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsup",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage",
    "lint": "pnpm run lint:format && pnpm run lint:style",
    "lint:fix": "pnpm run lint:format:fix && pnpm run lint:style:fix",
    "lint:format": "prettier --check '**/{src,test}/**/*.ts'",
    "lint:format:fix": "prettier --write '**/{src,test}/**/*.ts'",
    "lint:style": "eslint",
    "lint:style:fix": "eslint --fix",
    "lint:staged": "lint-staged -c ../../.lintstagedrc"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "preset": "ts-jest",
    "coverageDirectory": "./coverage",
    "collectCoverageFrom": [
      "./src/**/*.ts"
    ],
    "coverageReporters": [
      "lcov",
      "text"
    ],
    "testEnvironment": "node",
    "testTimeout": 30000,
    "transformIgnorePatterns": [
      "node_modules",
      "dist"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codibre/monorepo-utils.git",
    "directory": "libs/config-loom"
  },
  "bugs": {
    "url": "https://github.com/codibre/monorepo-utils/issues"
  },
  "homepage": "https://github.com/codibre/monorepo-utils/tree/main/libs/config-loom#readme",
  "author": "Codibre",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.17.0",
    "@types/picomatch": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.35.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "fast-glob": "^3.3.3",
    "globals": "^16.3.0",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "yaml": "^2.8.1"
  }
}
